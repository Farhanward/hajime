# Generated by hajime-brand/tools/emit.py from palette.toml.
# Written into /boot/loader.conf by hajime-brand/install_theme.sh, inside
# a marked block, so a second run replaces it instead of stacking a copy.
#
# Slot 7 is the console's default foreground and slot 0 its background,
# which is why they are the cream and the void and not white and black.

kern.vt.color.0.rgb="#0b0e1f"   # black
kern.vt.color.1.rgb="#b4453f"   # red
kern.vt.color.2.rgb="#4a7c59"   # green
kern.vt.color.3.rgb="#c8873a"   # brown
kern.vt.color.4.rgb="#1b3f9e"   # blue
kern.vt.color.5.rgb="#d97f83"   # magenta
kern.vt.color.6.rgb="#4ce0b0"   # cyan
kern.vt.color.7.rgb="#e0c4a8"   # white
kern.vt.color.8.rgb="#2a1f1c"   # bright black
kern.vt.color.9.rgb="#ff86c8"   # bright red
kern.vt.color.10.rgb="#8ef06a"   # bright green
kern.vt.color.11.rgb="#ffcc4d"   # bright brown
kern.vt.color.12.rgb="#2f6df0"   # bright blue
kern.vt.color.13.rgb="#e05cff"   # bright magenta
kern.vt.color.14.rgb="#63e8ff"   # bright cyan
kern.vt.color.15.rgb="#f0dcc4"   # bright white

# A 16x32 VGA face: at 1080p the 8x16 default is a line of ants, and this
# is the same grid the pixel art is drawn on.
screen.font="vgarom-16x32"

# The loader's own screen.
loader_logo="hajime"
loader_brand="hajime"
loader_menu_title="Hajime OS 1.0.0"
loader_color="YES"
